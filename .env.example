# ClozFlow web/ environment template. Copy to web/.env (local runs; main.py loads it)
# or set these in the host's environment (Render, docker compose `env_file: .env`).
# Every variable the backend reads is listed; blank means "use the built-in default"
# unless the comment says Required. Never commit real values.

# ── Core ─────────────────────────────────────────────────────────────────────
# Required in production: long random string that signs login tokens (unset = random per process, users signed out on restart).
JWT_SECRET_KEY=
# Legacy fallback name for JWT_SECRET_KEY; leave blank when JWT_SECRET_KEY is set.
SECRET_KEY=
# SQLAlchemy URL (postgres:// or postgresql://...); blank = SQLite file backend/hexagon.db.
DATABASE_URL=
# Postgres pool size (default 20).
DB_POOL_SIZE=
# Extra Postgres connections allowed above the pool (default 15).
DB_MAX_OVERFLOW=
# Seconds to wait for a free Postgres connection (default 30).
DB_POOL_TIMEOUT=
# Seconds before a pooled Postgres connection is recycled (default 1800).
DB_POOL_RECYCLE=
# Comma-separated browser origins allowed for CORS and copilot WebSockets; must include the public site origin (default: localhost dev ports + clozflow.com).
ALLOWED_ORIGINS=
# "production" makes the payment webhook refuse to run without PAYMENT_WEBHOOK_SECRET (default development).
ENV=
# Supabase project JWT secret; enables ClozFlow Cloud (Supabase) sign-in tokens.
SUPABASE_JWT_SECRET=

# ── Frontend build (docker compose build args, Vite) ─────────────────────────
# Supabase project URL baked into the web build for cloud sign-in.
VITE_SUPABASE_URL=
# Supabase anon (public) key baked into the web build.
VITE_SUPABASE_ANON_KEY=
# Port nginx listens on inside the container (default 8080; Render sets it).
PORT=

# ── AI providers ─────────────────────────────────────────────────────────────
# Google Gemini key: live copilot transcription stream.
GEMINI_API_KEY=
# Groq key: copilot suggestions, Pearl conversations, Sage, Relay and knowledge extraction.
GROQ_API_KEY=
# Research/LLM key used by lead, outreach and intelligence engines.
HEXAGON_RESEARCH_API_KEY=
# Google Places key for live lead search (blank = lead search falls back to research mode).
GOOGLE_PLACES_API_KEY=
# Deepgram key: live copilot transcription (Flux turn-based models, nova-3 fallback); preferred when set.
DEEPGRAM_API_KEY=
# Live copilot engine: "coach" (Meeting Wizard coach cards, default), "legacy" (built-in SalesAIEngine) or "brain" (local ClozFlow Brain).
CLOZFLOW_COPILOT_ENGINE=
# Live speech-to-text vendor: "auto" (default: deepgram if DEEPGRAM_API_KEY, else gemini, else sarvam), "deepgram", "gemini" or "sarvam".
CLOZFLOW_STT=
# Deepgram model for the rep's microphone channel (default flux-general-en).
CLOZFLOW_DEEPGRAM_MODEL_REP=
# Deepgram model for the prospect / mixed channel (default flux-general-multi: Hindi-English code-switching).
CLOZFLOW_DEEPGRAM_MODEL_PROSPECT=
# Deepgram model used when Flux isn't enabled for the key (default nova-3, with interim results and endpointing).
CLOZFLOW_DEEPGRAM_FALLBACK_MODEL=
# Flux end-of-turn confidence threshold 0.5–1.0 (default 0.7).
CLOZFLOW_DEEPGRAM_EOT_THRESHOLD=
# Flux eager end-of-turn threshold 0.3–0.9 that starts speculative coaching (default 0.5).
CLOZFLOW_DEEPGRAM_EAGER_EOT_THRESHOLD=
# Flux silence timeout in ms after which a turn ends regardless of confidence (default 3000).
CLOZFLOW_DEEPGRAM_EOT_TIMEOUT_MS=
# Sarvam realtime STT model (default saaras:v3-realtime).
CLOZFLOW_SARVAM_MODEL=
# Sarvam output mode: codemix (default; Hinglish in Latin script), transcribe, translate, verbatim or translit.
CLOZFLOW_SARVAM_MODE=
# Gemini model for live coach cards when GEMINI_API_KEY is set (default gemini-2.5-flash-lite, thinking off).
CLOZFLOW_COACH_MODEL=
# Groq model for live coach cards when only GROQ_API_KEY is set (default openai/gpt-oss-120b).
CLOZFLOW_COACH_GROQ_MODEL=
# Cost cap: coach cards per minute before the coaching intensity is lowered (default 4).
CLOZFLOW_COACH_MAX_CARDS_PER_MIN=
# Cost cap: minutes after which a live session drops to on-demand coaching (default 120).
CLOZFLOW_SESSION_MAX_MINUTES=
# Spoken recording disclosure on bridged phone calls: "off" (default; the rep announces), "on" (play it to the prospect after
# they answer) or "gate" (also ask them to press 1; the carrier's enforcement is unverified, the call bridges either way).
COPILOT_BRIDGE_DISCLOSURE=
# Custom disclosure text (one or two lines separated by \n; default English + Hinglish lines naming ClozFlow).
COPILOT_BRIDGE_DISCLOSURE_TEXT=
# Base URL of the local ClozFlow Brain; must be http://127.0.0.1|localhost (default http://127.0.0.1:8010).
CLOZFLOW_BRAIN_URL=
# Timeout in seconds for copilot calls to the Brain (default 300).
CLOZFLOW_BRAIN_TIMEOUT_SECONDS=
# Byte order of carrier L16 audio on the copilot bridge: "little" (default, Vobiz) or "big".
COPILOT_BRIDGE_L16_BYTE_ORDER=

# ── Meeting Wizard (briefs, debriefs, calendar, CRM) ─────────────────────────
# Gemini model for Wizard briefs/debriefs/rehearsal when GEMINI_API_KEY is set (default gemini-2.5-flash; Groq is the fallback).
CLOZFLOW_WIZARD_MODEL=
# "0" disables the optional homepage title/description fetch used to enrich a brief (default on).
CLOZFLOW_WIZARD_ENRICH=
# "0" skips the transcript retention sweep at startup (POST /api/wizard/admin/retention/run still works).
CLOZFLOW_WIZARD_RETENTION_SWEEP=
# Public base URL of this backend used to build OAuth redirect URIs for Google/Microsoft calendar and Zoho (default http://localhost:8000).
CLOZFLOW_WIZARD_OAUTH_REDIRECT_BASE=
# Google Calendar OAuth client (read-only events scope); blank = ICS link only (POST /calendar/sources returns 501 for google).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft Graph OAuth client (Calendars.ReadBasic); blank = ICS link only (501 for microsoft).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Zoho CRM OAuth client for the Wizard CRM connector; blank = webhook/BCC only (501 on /integrations/zoho/connect).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho accounts domain for OAuth (default https://accounts.zoho.in; use .com/.eu for other data centres).
ZOHO_ACCOUNTS_DOMAIN=
# Zoho CRM API domain (default https://www.zohoapis.in).
ZOHO_API_DOMAIN=

# ── Leads, outreach, relay, knowledge crawler ────────────────────────────────
# Parallel website enrichments per lead search (default 3).
LEAD_ENRICH_CONCURRENCY=
# Seconds allowed to enrich one lead (default 30).
LEAD_ENRICH_TIMEOUT_SECONDS=
# Max sub-areas a deep lead search scans (default 40).
DEEP_SEARCH_MAX_AREAS=
# Total seconds a deep lead search may run (default 300).
DEEP_SEARCH_TIME_BUDGET_SECONDS=
# Seconds to wait for the outreach-message LLM (default 30).
OUTREACH_LLM_TIMEOUT_SECONDS=
# Seconds to wait for the Relay-page LLM (default 90).
RELAY_LLM_TIMEOUT_SECONDS=
# Max bytes downloaded per crawled page (default 3145728 = 3 MB).
CRAWL_MAX_PAGE_BYTES=
# Seconds allowed per crawled page (default 20).
CRAWL_PAGE_DEADLINE_SECONDS=
# Seconds allowed for a whole website crawl (default 150).
CRAWL_MAX_SECONDS=

# ── Pearl voice agent ────────────────────────────────────────────────────────
# Required for Pearl phone calls: public HTTPS base URL of this backend that telephony webhooks call back (no default).
PEARL_PUBLIC_URL=
# Secret that signs telephony webhook/stream URLs (blank = derived from JWT_SECRET_KEY).
PEARL_WEBHOOK_SECRET=
# LLM model id for Pearl conversations and Sage (default qwen/qwen3.8-27b).
PEARL_LLM_MODEL=
# LLM model id for knowledge extraction (default qwen/qwen3.8-27b).
PEARL_EXTRACTION_MODEL=
# Primary text-to-speech provider: "sarvam" (default) or "elevenlabs". Any other provider
# whose key is set becomes an automatic mid-call fallback.
PEARL_TTS_PROVIDER=
# Sarvam AI key (TTS/STT).
SARVAM_API_KEY=
# ElevenLabs key (primary TTS when PEARL_TTS_PROVIDER=elevenlabs, otherwise fallback for Sarvam).
ELEVENLABS_API_KEY=
# Older spelling of ELEVENLABS_API_KEY, still read as a fallback.
ELEVEN_LABS_API_KEY=
# ElevenLabs voice id.
ELEVENLABS_VOICE_ID=
# ElevenLabs model id (default eleven_turbo_v2).
ELEVENLABS_MODEL_ID=
# Max concurrent outbound Pearl calls this server dials (default 20).
MAX_SERVER_CONCURRENCY=
# Silero VAD speech probability threshold (default 0.48).
PEARL_VAD_THRESHOLD=
# Minimum speech length in ms before VAD reports speech (default 64).
PEARL_MIN_SPEECH_MS=
# Consecutive speech frames that count as a barge-in (default 5).
PEARL_VAD_BARGE_IN_FRAMES=
# Speech probability needed for a barge-in (default 0.65).
PEARL_VAD_BARGE_IN_THRESHOLD=
# Silence in ms that ends a turn (default 480 live copilot, 1200 Pearl v2).
PEARL_END_OF_TURN_MS=
# End-of-turn silence in ms after a clearly finished sentence (default 280).
PEARL_SHORT_TURN_MS=
# End-of-turn silence in ms when the speaker seems mid-thought (default 900).
PEARL_LONG_TURN_MS=
# Hard cap in ms on a single utterance (default 15000).
PEARL_MAX_UTTERANCE_MS=
# Extra wait in ms for the final STT transcript after a turn ends (default 80).
PEARL_STT_FINAL_WAIT_MS=

# ── Telephony ────────────────────────────────────────────────────────────────
# Vobiz account id.
VOBIZ_ACCOUNT_ID=
# Vobiz auth id.
VOBIZ_AUTH_ID=
# Vobiz auth secret.
VOBIZ_AUTH_SECRET=
# Vobiz caller ID (E.164) used for outbound calls.
VOBIZ_CALLER_ID=
# Vobiz API base URL (default https://api.vobiz.ai).
VOBIZ_BASE_URL=
# Exotel account SID.
EXOTEL_ACCOUNT_SID=
# Exotel API key.
EXOTEL_API_KEY=
# Exotel API token.
EXOTEL_API_TOKEN=
# Exotel caller ID / ExoPhone for outbound calls.
EXOTEL_CALLER_ID=
# Exotel API base URL (default https://api.exotel.com).
EXOTEL_BASE_URL=
# Exotel API subdomain/region (default api).
EXOTEL_SUBDOMAIN=

# ── Payments & misc ──────────────────────────────────────────────────────────
# Secret that verifies payment-provider webhooks.
PAYMENT_WEBHOOK_SECRET=
# Fallback name for PAYMENT_WEBHOOK_SECRET (Razorpay).
RAZORPAY_WEBHOOK_SECRET=
# "true" lets the knowledge crawler fetch localhost URLs (development only; default false).
ALLOW_LOCALHOST_CRAWL=
# Opt-in: "true" saves copilot exchanges (the prospect's words + the AI reply) to logs/*.jsonl for model training. Default off for privacy.
CLOZFLOW_LEARNING_LOG=

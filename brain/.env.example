# Copy to .env and supply credentials. Never commit private keys or API keys.
CEB_ENVIRONMENT=local
CEB_AUTH_MODE=local
CEB_STORAGE_PROFILE=durable
CEB_DATABASE_URL=sqlite:///data/runtime.sqlite
CEB_SCHEDULER_MODE=local
CEB_ENGINES_CONFIG=configs/engines.local.yaml
CEB_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CEB_LLM_TIMEOUT_SECONDS=30
CEB_PORT=8110
CEB_EMBEDDING_CLIENT=lexical
CEB_DATA_KEY_FILE=data/keys/runtime.key
CEB_QDRANT_MODE=memory

# Production requires JWT mode and an external issuer's RSA public key.
# CEB_ENVIRONMENT=production
# CEB_AUTH_MODE=jwt
# CEB_JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
# CEB_JWT_ISSUER=https://your-auth-service
# CEB_JWT_AUDIENCE=clozflow-brain
# CEB_SESSION_STARTS_PER_HOUR=100
# CEB_EVENTS_PER_MINUTE=10000

# Durable production stores and distributed scheduler are opt-in.
# CEB_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/clozflow_brain
# CEB_WORLD_MODEL_REPOSITORY=redis_json
# CEB_REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0
# CEB_EVENT_BUS=kafka
# CEB_KAFKA_BOOTSTRAP_SERVERS=HOST:9092
# CEB_SCHEDULER_MODE=celery
# CEB_TELEMETRY=otel
# CEB_OTEL_EXPORTER=otlp

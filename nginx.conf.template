# ClozFlow production proxy. entrypoint.sh renders it with envsubst '${PORT}'.
# FastAPI listens on 127.0.0.1:8000; everything else is the built SPA.
# Keep the backend prefixes in sync with the routers mounted in backend/main.py
# (backend/tests/test_core_infra.py fails when a mounted path isn't proxied).

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Access logs must never contain query strings: carrier webhooks carry their
# per-call secret in ?t= and some clients send ?token=<JWT>. Log the path and
# the Referer without anything after "?".
map $request_uri $clozflow_log_path {
    "~^(?<clozflow_path_only>[^?]*)" $clozflow_path_only;
    default "-";
}
map $http_referer $clozflow_log_referer {
    "~^(?<clozflow_referer_only>[^?]*)" $clozflow_referer_only;
    default "-";
}
log_format clozflow_redacted '$remote_addr - [$time_local] "$request_method $clozflow_log_path $server_protocol" '
                             '$status $body_bytes_sent "$clozflow_log_referer" "$http_user_agent" $request_time';

server {
    listen ${PORT};
    server_name _;

    access_log /var/log/nginx/access.log clozflow_redacted;

    # Serve Frontend static files
    root /app/frontend_dist;
    index index.html;

    # The API accepts 5 MB avatars and knowledge uploads of up to 20 MB per file
    # and 100 MB per request; nginx's 1 MB default would reject them with 413
    # before they reach FastAPI.
    client_max_body_size 100m;

    # Upstream settings shared by every location below (none of them sets its
    # own proxy_set_header, so these are inherited). The Upgrade/Connection pair
    # lets any backend path upgrade to a WebSocket.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Long-lived sockets and streams:
    #   /ws, /ws/audio       live copilot WebSockets
    #   /api/copilot/**      copilot bridge (WebSockets and HTTP)
    #   /api/pearl/**        Pearl call / test-session WebSockets, SSE and API
    location ~ ^/(ws(/|$)|api/copilot/|api/pearl/) {
        proxy_pass http://127.0.0.1:8000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Backend auth endpoints only: /auth and /auth/callback are SPA routes.
    location ~ ^/auth/(login|register|me)$ {
        proxy_pass http://127.0.0.1:8000;
    }

    # Every other backend prefix. Anchored with (/|$) so SPA routes such as
    # /call-brief and /outreach-studio stay with the frontend.
    # Buffering is off for the SSE streams under /leads and /api/knowledge.
    location ~ ^/(api|calls|call|leads|outreach|intelligence|health)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Uploaded avatars and voice previews (served by FastAPI)
    location ^~ /static/ {
        proxy_pass http://127.0.0.1:8000;
        add_header X-Content-Type-Options nosniff always;
    }

    # Frontend SPA fallback — must be last
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ============================================================
# PEARL EVALUATION LAB — ENVIRONMENT CONFIGURATION
# ============================================================
# DO NOT copy production secrets into this file.
# Dedicated testing and evaluation API keys only.

# Environment Mode: local, staging, mock
EVAL_ENVIRONMENT=mock

# External Judge LLM API Configuration (Optional - for LLM-as-judge)
EVAL_JUDGE_PROVIDER=groq
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=qwen/qwen3.8-27b

# Local ClozFlow Server URL (Only required when using LocalApiPearlAdapter)
PEARL_API_BASE_URL=http://localhost:8000
PEARL_TEST_USER_TOKEN=

# Evaluation Concurrency & Timeouts
EVAL_MAX_CONCURRENCY=4
EVAL_REQUEST_TIMEOUT_SECONDS=30
EVAL_MAX_TURNS_PER_SCENARIO=8

# Strict Telephony Isolation Flag (Must remain false at all times)
ALLOW_REAL_TELEPHONY=false
